# --- Auth (GitHub OAuth app: callback URL = <origin>/api/auth/callback/github) ---
AUTH_SECRET=generate-with-npx-auth-secret
AUTH_GITHUB_ID=your-github-oauth-client-id
AUTH_GITHUB_SECRET=your-github-oauth-client-secret

# --- Model providers (set the ones you have; models auto-enable per key) ---
# Cerebras — ultra-fast inference (llama-3.3-70b, llama3.1-8b, qwen-3-32b)
CEREBRAS_API_KEY=
# Groq — hosts Gemma 2 (gemma2-9b-it) with very low latency
GROQ_API_KEY=
# Google AI Studio — Gemma 3 + Gemini flash
GOOGLE_AI_API_KEY=
# OpenAI — gpt-4o-mini baseline
OPENAI_API_KEY=

# Optional: where the SQLite database lives (defaults to ./data/loqui.db)
# LOQUI_DB_PATH=./data/loqui.db
